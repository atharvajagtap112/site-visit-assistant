# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sitevisit
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/sitevisit_test
# Password for all demo staff accounts. Used only by the seed.
DEMO_PASSWORD=
# The seed wipes every table. Set to "yes" only to seed a non-local demo database.
ALLOW_SEED_RESET=
GROQ_API_KEY=
# There is no SMS provider, so buyer codes only work when shown on screen. Set to "yes" for the demo.
# Anything else stops codes being issued, and buyers are told codes cannot be sent.
DEMO_SHOW_CODES=
# Hosted demo database (Neon). In Vercel, set this value as DATABASE_URL instead.
NEON_DATABASE_URL=
